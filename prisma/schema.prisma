generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SummaryCache {
  id         String   @id @default(cuid())
  videoId    String   @unique
  title      String
  thumbnail  String
  transcript String
  summary    String
  markdown   String
  createdAt  DateTime @default(now())
}
